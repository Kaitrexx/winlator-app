<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NFS_DIALOG_V1 -->
    <style name="NfsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#2A2A2E</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
    <style name="NfsButtonBase" parent="BaseButton">
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:layout_marginLeft">8dp</item>
    </style>
    <style name="NfsButtonNeutral" parent="NfsButtonBase">
        <item name="android:background">@drawable/nfs_button_outline</item>
        <item name="android:textColor">#FFC107</item>
    </style>
    <style name="NfsButtonPositive" parent="NfsButtonBase">
        <item name="android:background">@drawable/nfs_button_solid</item>
        <item name="android:textColor">#0F0F11</item>
    </style>
</resources>
